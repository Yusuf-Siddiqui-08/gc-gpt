# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual envs
.env
.venv
ENV/
venv/

# SQLite databases
app.db
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db

# Node modules (not needed for build-only client)
node_modules/
client/node_modules/
client/src/
client/public/

# JetBrains IDE (PyCharm/IDEA) project files
# By default, ignore the entire .idea directory to avoid user-specific files being committed.
.idea/
*.iml

# If you need to share only sanitized, minimal code style settings, you can opt-in to track
# specific code style XMLs while keeping the rest of .idea ignored. One safe approach is to use
# the following pattern (uncomment to use):
#
#   # Ignore everything inside .idea but allow code style XMLs
#   .idea/*
#   !.idea/codeStyles/
#   !.idea/codeStyles/*.xml
#
# Make sure any committed XMLs contain no user- or machine-specific data.

# Logs
*.log
